{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["APP_ENV", "CLOUDFLARE_ENV", "VITE_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**", "storybook-static/**"]
    },
    "build:types": {
      "dependsOn": ["^build:types"],
      "outputs": ["dist/**/*.d.ts", "dist/**/*.d.ts.map"]
    },
    "typegen": {
      "env": ["CLOUDFLARE_ENV"],
      "outputs": ["worker-configuration.d.ts", ".react-router/types/**"]
    },
    "check-types": {
      "dependsOn": ["typegen", "^build:types"],
      "outputs": []
    },
    "check": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["typegen", "^build:types"],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["CI", "CLOUDFLARE_ENV"]
    },
    "dev": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_ENV"],
      "persistent": true
    }
  }
}
