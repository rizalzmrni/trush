{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(bun run *)",
      "Bash(bunx turbo *)",
      "Bash(bunx ultracite *)",
      "Bash(bunx vitest *)",
      "Bash(bunx wrangler types*)",
      "Bash(bunx drizzle-kit generate*)",
      "Bash(bun x auth@latest generate*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr merge * --squash --auto --delete-branch)",
      "Bash(git fetch*)",
      "Bash(git pull --ff-only*)",
      "Bash(bunx playwright *)"
    ],
    "ask": [
      "Bash(git rebase *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git push --force-with-lease *)"
    ],
    "deny": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git reset --hard*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git push *--no-verify*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh pr review *)",
      "Bash(gh api *)",
      "Bash(bunx drizzle-kit push*)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.dev.vars)",
      "Bash(bunx wrangler deploy*)",
      "Bash(bunx wrangler secret*)",
      "Bash(bunx wrangler rollback*)",
      "Bash(bun run deploy*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.ts\""
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-task.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
