    "shadcn": "catalog:ui",
    "tw-animate-css": "catalog:ui"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:test",
    "@testing-library/react": "catalog:test",
    "@trush/typescript-config": "workspace:*",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "happy-dom": "catalog:test",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "tailwindcss": "catalog:ui",
    "typescript": "catalog:",
