{
  "name": "@trush/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "auth:generate": "bun x auth@1.7.14 generate --config src/auth.cli.ts --output ../db/src/schema/auth.ts --yes",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@trush/db": "workspace:*",
    "@trush/env": "workspace:*",
    "better-auth": "catalog:services",
    "drizzle-orm": "catalog:db",
    "hono": "catalog:api"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:db",
    "@trush/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:test"
  }
}
