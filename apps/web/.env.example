# Salin ke .env (tidak di-commit). Var VITE_* masuk bundel publik: tanpa secret.
# Skema klien: createWebEnv di @trush/env (packages/env/src/web.ts).
# E2E (CLOUDFLARE_ENV=e2e): VITE_* di bawah diisi lewat env proses (env
# webServer Playwright, diteruskan turbo) dan mengalahkan .env ini.
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5174
# URL publik situs ini: canonical, og:url, Sitemap di robots.txt.
VITE_SITE_URL=http://localhost:5173
