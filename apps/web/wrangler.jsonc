{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Blok top-level = development lokal (`bun run dev`); APP_ENV dari .dev.vars.
  // Lingkungan dipilih dengan CLOUDFLARE_ENV saat `vite build`
  // (docs/environments.md), bukan flag --env.
  "name": "trush-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-04",
  "observability": {
    "enabled": true,
  },
  "env": {
    // Lingkungan lokal Playwright (CLOUDFLARE_ENV=e2e), tidak pernah
    // di-deploy. Secret di .dev.vars.e2e (menggantikan .dev.vars), VITE_* dari
    // env proses (webServer Playwright).
    "e2e": {
      "name": "trush-web-e2e",
      "vars": {
        "APP_ENV": "development",
      },
    },
    "staging": {
      "name": "trush-web-staging",
      "vars": {
        "APP_ENV": "staging",
      },
    },
    "production": {
      "name": "trush-web-production",
      "vars": {
        "APP_ENV": "production",
      },
    },
  },
}
