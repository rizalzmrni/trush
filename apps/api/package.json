{
  "name": "@trush/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/types/client.d.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "typegen": "wrangler types --env-file .dev.vars.example",
    "check-types": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.types.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:api",
    "@scalar/hono-api-reference": "catalog:api",
    "@trush/auth": "workspace:*",
    "@trush/core": "workspace:*",
    "@trush/db": "workspace:*",
    "@trush/env": "workspace:*",
    "@trush/observability": "workspace:*",
    "hono": "catalog:api",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:test",
    "@electric-sql/pglite": "catalog:db",
    "@trush/typescript-config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:test",
    "wrangler": "catalog:api"
  }
}
