{
  "extends": "@trush/typescript-config/base.json",
  "compilerOptions": {
    // Global Worker (fetch, Request, crypto) dari `wrangler types`, bukan DOM.
    "lib": ["ES2024"],
    // Template `@trush/email` (.tsx) ikut dicek lewat impor.
    "jsx": "react-jsx",
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["src", "vitest.config.ts"],
  // Project `db` (Node + PGlite) memuat @types/node lewat rantai impor
  // `@trush/db/testing`; tipenya bentrok dengan global Worker, jadi dicek
  // tsconfig.node.json.
  "exclude": ["src/**/*.db.test.ts", "src/testing/db-*.ts"]
}
