# Salin ke .dev.vars (tidak di-commit). Nilai di bawah palsu.
# Skema: createApiEnv di @trush/env (packages/env/src/api.ts).
APP_ENV=development
API_DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=debug
# BetterStack: kosongkan keduanya di development (log hanya ke console).
BETTERSTACK_INGEST_URL=
BETTERSTACK_SOURCE_TOKEN=
# Neon branch dev, koneksi pooled (host -pooler). Migrasi memakai
# DATABASE_URL_UNPOOLED di packages/db/.dev.vars.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# better-auth. Secret: `openssl rand -base64 32` (min 32 karakter).
BETTER_AUTH_SECRET=dev-only-secret-ganti-dengan-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:8787
# Kosongkan di development (cookie hanya untuk host api).
AUTH_COOKIE_DOMAIN=
# Kunci uji Cloudflare Turnstile yang selalu lolos (docs/auth-plugins.md).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Telepon (@trush/phone). Development: `log` menulis OTP ke log lokal.
# Pilihan: memory | log | twilio-test | twilio (production hanya twilio).
PHONE_DRIVER=log
PHONE_ALLOWED_COUNTRIES=ID
# Wajib saat staging + twilio: nomor E.164 tim, dipisah koma.
PHONE_ALLOWLIST=
# Driver twilio (API Key, bukan Auth Token utama).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_OTP_CONTENT_SID=
# Driver twilio-test (test credentials dari Console Twilio, tanpa biaya).
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=
