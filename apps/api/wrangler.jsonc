{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trush-api",
  "main": "src/index.ts",
  // Sama di semua app; >= 2026-08-04 mengaktifkan Node.js compat tanpa flag.
  "compatibility_date": "2026-08-04",
  // Workers Logs: baris JSON dari sink console @trush/observability.
  "observability": {
    "enabled": true,
  },
  // Development: APP_ENV dan nilai lain datang dari .dev.vars (tanpa default).
  // Secret per lingkungan (DATABASE_URL, BETTER_AUTH_SECRET,
  // TURNSTILE_SECRET_KEY, TWILIO_*, RESEND_API_KEY) diset manusia lewat
  // `wrangler secret put`.
  "env": {
    // Lingkungan lokal Playwright (CLOUDFLARE_ENV=e2e `wrangler dev`), tidak
    // pernah di-deploy. Nama Worker = service binding `API` blok e2e
    // apps/app (dev registry lokal). Secret (DATABASE_URL,
    // BETTER_AUTH_SECRET, TURNSTILE_SECRET_KEY) di .dev.vars.e2e, yang
    // menggantikan .dev.vars sepenuhnya. OTP dan email dibaca lewat
    // GET /__e2e/outbox.
    "e2e": {
      "name": "trush-api-e2e",
      "vars": {
        "APP_ENV": "development",
        "E2E": true,
        "API_DOCS_ENABLED": true,
        "LOG_LEVEL": "info",
        "CORS_ORIGINS": "http://localhost:5174,http://localhost:5173",
        "APP_URL": "http://localhost:5174",
        "BETTER_AUTH_URL": "http://localhost:8787",
        "PHONE_DRIVER": "memory",
        "PHONE_ALLOWED_COUNTRIES": "ID",
        "EMAIL_DRIVER": "memory",
      },
    },
    "staging": {
      "name": "trush-api-staging",
      "vars": {
        "APP_ENV": "staging",
        "API_DOCS_ENABLED": true,
        "LOG_LEVEL": "info",
        "CORS_ORIGINS": "https://trush-app-staging.rizalzmrni.workers.dev,https://trush-web-staging.rizalzmrni.workers.dev",
        // URL app staging (harus ada di CORS_ORIGINS).
        "APP_URL": "https://trush-app-staging.rizalzmrni.workers.dev",
        // URL Worker api staging. AUTH_COOKIE_DOMAIN kosong di *.workers.dev.
        "BETTER_AUTH_URL": "https://trush-api-staging.rizalzmrni.workers.dev",
        // Twilio sungguhan, hanya ke nomor tim (PHONE_ALLOWLIST wajib).
        "PHONE_DRIVER": "twilio",
        "PHONE_ALLOWED_COUNTRIES": "ID",
        // PHONE_ALLOWLIST (nomor E.164 tim, dipisah koma) berisi data pribadi
        // dan repo publik, jadi diisi sebagai secret:
        // `CLOUDFLARE_ENV=staging wrangler secret put PHONE_ALLOWLIST`.
        // Resend sungguhan, hanya ke alamat/domain tim (EMAIL_ALLOWLIST wajib).
        "EMAIL_DRIVER": "resend",
        // Tanpa domain terverifikasi, Resend hanya menerima pengirim
        // onboarding@resend.dev (dan hanya ke email pemilik akun Resend).
        // L7: ganti ke domain pengirim staging setelah terverifikasi.
        "EMAIL_FROM": "trush staging <onboarding@resend.dev>",
        // EMAIL_ALLOWLIST juga secret (data pribadi):
        // `CLOUDFLARE_ENV=staging wrangler secret put EMAIL_ALLOWLIST`.
      },
    },
    "production": {
      "name": "trush-api-production",
      "vars": {
        "APP_ENV": "production",
        "API_DOCS_ENABLED": false,
        "LOG_LEVEL": "info",
        // L4: ganti dengan domain resmi (app.<domain>, <domain>).
        "CORS_ORIGINS": "https://app.example.com,https://example.com",
        // L4: URL app produksi (harus ada di CORS_ORIGINS).
        "APP_URL": "https://app.example.com",
        // L4: ganti dengan domain resmi. Secret (DATABASE_URL,
        // BETTER_AUTH_SECRET, TURNSTILE_SECRET_KEY) lewat `wrangler secret put`.
        "BETTER_AUTH_URL": "https://api.example.com",
        "AUTH_COOKIE_DOMAIN": "example.com",
        "PHONE_DRIVER": "twilio",
        "PHONE_ALLOWED_COUNTRIES": "ID",
        // L7: domain pengirim produksi terverifikasi di Resend.
        "EMAIL_DRIVER": "resend",
        "EMAIL_FROM": "trush <noreply@example.com>",
      },
    },
  },
}
