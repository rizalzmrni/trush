{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trush-api",
  "main": "src/index.ts",
  // Sama di semua app; >= 2026-08-04 mengaktifkan Node.js compat tanpa flag.
  "compatibility_date": "2026-08-04",
  // Workers Logs: baris JSON dari sink console @trush/observability.
  "observability": {
    "enabled": true,
  },
  // Development: APP_ENV dan nilai lain datang dari .dev.vars (tanpa default).
  // Secret per lingkungan (DATABASE_URL, BETTER_AUTH_SECRET,
  // TURNSTILE_SECRET_KEY, TWILIO_*) diset manusia lewat `wrangler secret put`.
  "env": {
    // Lingkungan lokal Playwright (CLOUDFLARE_ENV=e2e `wrangler dev`), tidak
    // pernah di-deploy. Nama Worker = service binding `API` blok e2e
    // apps/app (dev registry lokal). Secret (DATABASE_URL,
    // BETTER_AUTH_SECRET, TURNSTILE_SECRET_KEY) di .dev.vars.e2e, yang
    // menggantikan .dev.vars sepenuhnya. OTP dibaca lewat GET /__e2e/outbox.
    "e2e": {
      "name": "trush-api-e2e",
      "vars": {
        "APP_ENV": "development",
        "E2E": true,
        "API_DOCS_ENABLED": true,
        "LOG_LEVEL": "info",
        "CORS_ORIGINS": "http://localhost:5174,http://localhost:5173",
        "BETTER_AUTH_URL": "http://localhost:8787",
        "PHONE_DRIVER": "memory",
        "PHONE_ALLOWED_COUNTRIES": "ID",
      },
    },
    "staging": {
      "name": "trush-api-staging",
      "vars": {
        "APP_ENV": "staging",
        "API_DOCS_ENABLED": true,
        "LOG_LEVEL": "info",
        // L3: ganti dengan URL *.workers.dev app & web staging yang sebenarnya.
        "CORS_ORIGINS": "https://trush-app-staging.example.workers.dev,https://trush-web-staging.example.workers.dev",
        // L3: URL Worker api staging. AUTH_COOKIE_DOMAIN kosong di *.workers.dev.
        "BETTER_AUTH_URL": "https://trush-api-staging.example.workers.dev",
        // Twilio sungguhan, hanya ke nomor tim (PHONE_ALLOWLIST wajib).
        "PHONE_DRIVER": "twilio",
        "PHONE_ALLOWED_COUNTRIES": "ID",
        // L3: isi nomor E.164 tim, dipisah koma.
        "PHONE_ALLOWLIST": "+6280000000000",
      },
    },
    "production": {
      "name": "trush-api-production",
      "vars": {
        "APP_ENV": "production",
        "API_DOCS_ENABLED": false,
        "LOG_LEVEL": "info",
        // L4: ganti dengan domain resmi (app.<domain>, <domain>).
        "CORS_ORIGINS": "https://app.example.com,https://example.com",
        // L4: ganti dengan domain resmi. Secret (DATABASE_URL,
        // BETTER_AUTH_SECRET, TURNSTILE_SECRET_KEY) lewat `wrangler secret put`.
        "BETTER_AUTH_URL": "https://api.example.com",
        "AUTH_COOKIE_DOMAIN": "example.com",
        "PHONE_DRIVER": "twilio",
        "PHONE_ALLOWED_COUNTRIES": "ID",
      },
    },
  },
}
