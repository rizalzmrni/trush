# Salin ke .env (tidak di-commit). Var VITE_* masuk bundel publik: tanpa secret.
# Skema klien: createAppEnv di @trush/env (packages/env/src/app.ts).
VITE_APP_ENV=development
# URL publik apps/api untuk fetch dari browser (credentials: "include").
# Loader/action memanggil api lewat Service Binding API, bukan URL ini.
VITE_API_URL=http://localhost:8787
# Site key Cloudflare Turnstile; nilai ini kunci uji yang selalu lolos
# (docs/auth-plugins.md). Staging/production memakai widget masing-masing.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
